{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ContactDb": "Server=(localdb)\\MSSQLLocalDB;Database=ContactMS;Trusted_Connection=True;TrustServerCertificate=True",
    //"ContactLogDb": "Server=(localdb)\\MSSQLLocalDB;Database=ContactLog;Trusted_Connection=True;TrustServerCertificate=True"
  },

  //Serilog  connection
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  // Hierarchy connection
  "HierarchyAPI": {
    "URL": "https://localhost:7285",
    "AzureToken": "123456"
  }
}


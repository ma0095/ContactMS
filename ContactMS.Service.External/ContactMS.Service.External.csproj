<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContactMS.DTOs\ContactMS.DTOs.csproj" />
    <ProjectReference Include="..\ContactMS.Service.External.Contracts\ContactMS.Service.External.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="URLStack.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>URLStack.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="URLStack.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>URLStack.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
